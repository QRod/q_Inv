      "html": "<button class=\"ds-button-primary\">Guardar servidor</button>",
      "css": ".ds-button-primary{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;background:var(--accent,#242824);color:var(--on-accent,#fff);border:1px solid var(--accent,#242824);border-radius:6px;min-height:40px;padding:9px 14px;font-weight:600;cursor:pointer;transition:background .16s ease-out}.ds-button-primary:hover{filter:brightness(.9)}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#255dbb);outline-offset:3px}.ds-button-primary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Cancelar",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Cancelar de la implementación operativa.",
      "html": "<button class=\"ds-button-secondary\">Cancelar</button>",
      "css": ".ds-button-secondary{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;background:var(--control,#fff);color:var(--text,#202321);border:1px solid var(--border,#c8cdc6);border-radius:6px;min-height:40px;padding:9px 14px;font-weight:600;cursor:pointer;transition:background .16s ease-out}.ds-button-secondary:hover{background:var(--hover,#e8ebe5)}.ds-button-secondary:focus-visible{outline:3px solid var(--focus,#255dbb);outline-offset:3px}.ds-button-secondary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "Eliminar definitivamente",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Eliminar definitivamente de la implementación operativa.",
      "html": "<button class=\"ds-button-danger\">Eliminar definitivamente</button>",
      "css": ".ds-button-danger{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;background:var(--danger-bg,#fff0ed);color:var(--danger,#a32524);border:1px solid var(--danger,#a32524);border-radius:6px;min-height:40px;padding:9px 14px;font-weight:600;cursor:pointer;transition:background .16s ease-out}.ds-button-danger:hover{background:var(--hover,#e8ebe5)}.ds-button-danger:focus-visible{outline:3px solid var(--focus,#255dbb);outline-offset:3px}.ds-button-danger:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none}}"
    },
    {
      "name": "Buscar servidor",
      "kind": "input",
      "refersTo": "field",
      "description": "Buscar servidor de la implementación operativa.",
      "html": "<label class=\"ds-field-label\">Buscar servidor<input class=\"ds-field\" placeholder=\"Nombre o grupo\"></label>",
      "css": ".ds-field-label{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;display:grid;gap:8px;color:var(--text,#202321)}.ds-field{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;min-height:42px;min-width:0;padding:10px 11px;border:1px solid var(--border,#c8cdc6);border-radius:5px;background:var(--control,#fff);color:var(--text,#202321)}.ds-field::placeholder{color:var(--muted,#535b55);opacity:1}.ds-field:focus-visible{outline:3px solid var(--focus,#255dbb);outline-offset:3px}"
    },
    {
      "name": "Etiqueta",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Etiqueta de la implementación operativa.",
      "html": "<span class=\"ds-badge\">Crítico</span>",
      "css": ".ds-badge{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;display:inline-block;font-size:12px;font-weight:500;padding:3px 7px;border-radius:4px;background:var(--subtle,#eeeee9);color:var(--text,#202321)}"
    },
    {
      "name": "Navegación activa",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Navegación activa de la implementación operativa.",
      "html": "<button class=\"ds-nav\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 4h18v6H3z M3 14h18v6H3z M6 7h.01 M6 17h.01\"/></svg>Inventario</button>",
      "css": ".ds-nav{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;display:flex;align-items:center;gap:11px;padding:12px;border:0;border-radius:6px;min-height:40px;background:var(--subtle,#eeeee9);color:var(--text,#202321);font-weight:700;cursor:pointer}.ds-nav svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-nav:hover{background:var(--hover,#e8ebe5)}.ds-nav:focus-visible{outline:3px solid var(--focus,#255dbb);outline-offset:3px}"
    },
    {
      "name": "Widget de servidor",
      "kind": "card",
      "refersTo": "server-widget",
      "description": "Widget de servidor de la implementación operativa.",
      "html": "<article class=\"ds-widget\"><h2>Servidor de ejemplo</h2><p class=\"ds-state\">Conectado</p><p class=\"ds-metric\">CPU 0 % · Mem 40 %</p><p class=\"ds-context\">Capacidades y mediciones diferenciadas</p></article>",
      "css": ".ds-widget{font-family:var(--ds-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;background:var(--surface,#fff);color:var(--text,#202321);border:1px solid var(--border,#c8cdc6);border-radius:12px;padding:22px}.ds-widget h2{font-size:18px;margin:0}.ds-state{color:var(--positive,#17673b);font-size:12px;font-weight:650;border-bottom:1px solid var(--border,#c8cdc6);padding-bottom:16px}.ds-state:before{content:\"\";display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;margin-right:6px}.ds-metric{font-variant-numeric:tabular-nums}.ds-context{font-size:12px;color:var(--muted,#535b55)}"
    }
  ],
  "narrative": {
    "northStar": "Instrumentación operativa",
    "overview": "q_Inv interpreta las referencias Braun/Nothing autorizadas mediante superficies cálidas o carbón, divisores finos, tinta legible y controles familiares. La densidad sirve al trabajo diario de infraestructura y a la comparación de datos; el español y la lectura precisa son compromisos duraderos.\n\nEl sistema documenta la implementación final en HTML/CSS/JavaScript. La dirección Operate se construyó directamente en código, sin comp raster ni seed: esa omisión está declarada en el contrato de dirección y no equivale a una aprobación de assets inexistentes.",
    "keyCharacteristics": [
      "Superficies planas con contraste tonal.",
      "Cifras tabulares y estados escritos.",
      "Tema claro, oscuro o del sistema.",
      "Controles reconocibles y foco visible."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "El color de estado acompaña una etiqueta o un valor; no sustituye el significado textual.",
        "section": "colors"
      },
      {
        "name": "The Operational Type Rule",
        "body": "La sans del sistema es tipografía de trabajo; las métricas usan cifras tabulares, sin introducir una fuente display decorativa.",
        "section": "typography"
      },
      {
        "name": "The Modal Depth Rule",
        "body": "La sombra aísla una tarea modal; las tarjetas permanecen planas y se separan con borde y tono.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conservar los pares semánticos de cada tema y el foco visible.",
      "Do mostrar unidades, capacidades y métricas como conceptos distintos.",
      "Do representar ausencia con raya y texto explicativo; cero sigue siendo una medición válida.",
      "Do mantener etiquetas accesibles en iconos de acción y confirmación en operaciones masivas."
    ],
    "donts": [
      "Don't usar un error SSH como prueba de que el servidor está apagado.",
      "Don't convertir tarjetas en capas de sombras decorativas.",
      "Don't reemplazar los iconos SVG de acción por glifos o depender solo del color.",
      "Don't guardar la preferencia de apariencia como configuración del servidor."
    ]
  }
}
